{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    "customManagers:githubActionsVersions"
  ],
  "timezone": "Europe/Berlin",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency Dashboard",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 8,
  "rebaseWhen": "behind-base-branch",
  "rangeStrategy": "bump",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "labels": [
    "dependencies"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/test/**",
    "**/tests/**",
    "**/__tests__/**",
    "**/__fixtures__/**"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ]
  },
  "pre-commit": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ],
    "automerge": true
  },
  "packageRules": [
    {
      "description": "mise is pinned as MISE_VERSION in every workflow that sets it up; move them at once, and only to a release a day old, the age mise-action waited for before the pin.",
      "matchDepNames": [
        "jdx/mise"
      ],
      "groupName": "mise",
      "groupSlug": "mise",
      "minimumReleaseAge": "1 day"
    },
    {
      "description": "Automerge digest, pin, patch, and minor updates once CI passes.",
      "matchUpdateTypes": [
        "digest",
        "pin",
        "pinDigest",
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Keep major updates explicit.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group GitHub Actions updates together.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "dependencyDashboardApproval": false
    },
    {
      "description": "Zig is pinned in .mise.toml, which Renovate's mise manager reads (ziglang/zig tags). Every 0.x minor release changes the standard library and the build API, so those bumps come with code changes and are never automerged; patch releases are. .minimum_zig_version in build.zig.zon is the oldest supported Zig and is bumped by hand.",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "zig"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "groupName": "Zig toolchain",
      "groupSlug": "zig-toolchain",
      "automerge": false,
      "dependencyDashboardApproval": false
    },
    {
      "description": "bun is pinned in .mise.toml and as @types/bun; move them at once.",
      "matchDepNames": [
        "bun",
        "@types/bun"
      ],
      "groupName": "bun",
      "groupSlug": "bun"
    },
    {
      "description": "The docs site ships nothing; its bumps are chores.",
      "matchFileNames": [
        "docs/**"
      ],
      "semanticCommitType": "chore"
    },
    {
      "description": "Leave engines.node alone. It is the oldest Node the docs site supports, not the toolchain.",
      "matchDepTypes": [
        "engines"
      ],
      "enabled": false
    },
    {
      "description": "The commit message check must parse with the release-please version the release-please action bundles (see its package-lock.json), not the newest one. Bump it by hand alongside sigil's.",
      "matchFileNames": [
        ".github/commit-lint/package.json"
      ],
      "matchPackageNames": [
        "release-please"
      ],
      "enabled": false
    },
    {
      "description": "Group docs site dependencies together.",
      "matchFileNames": [
        "docs/package.json",
        "docs/bun.lock"
      ],
      "groupName": "docs dependencies",
      "groupSlug": "docs-dependencies"
    },
    {
      "description": "Hold the docs site on TypeScript 6 and below. TypeScript 7 is the native compiler and has no JavaScript API, and @vue/compiler-sfc reads files through that API (ts.sys) to resolve imported prop types in components, so the docs build fails on it. Lift this once @vue/compiler-sfc no longer needs it.",
      "matchFileNames": [
        "docs/package.json"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    }
  ]
}
